# Copy this file to .env for local, non-Docker development (`go run ./cmd/api` reads these via
# the shell environment — Go itself does not auto-load .env files; use `docker compose up` instead
# if you'd rather not export these by hand). NEVER commit the real .env — it's already
# .gitignore'd. See specs/global/02_SECURITY_BASELINE.md §5.

ADDR=:8080
APP_ENV=local

# Matches docker-compose.yml's mysql service when running the API outside Docker but the DB
# inside it (`docker compose up mysql` then `go run ./cmd/api`). Port 3307, not MySQL's default
# 3306 — see docker-compose.yml's comment: avoids clashing with a MySQL already running locally.
DB_DSN=brightbuy_app:devapppass@tcp(127.0.0.1:3307)/brightbuy?parseTime=true

# Dev-only placeholder. A real deployment generates a long random value and stores it in a
# secret manager, never in a file like this one.
JWT_SIGNING_KEY=dev-only-signing-key-change-me

S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=devsecretkey
