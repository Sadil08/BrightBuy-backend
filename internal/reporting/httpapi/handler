package httpapi

import (
	"encoding/csv"
	"net/http"
	"strconv"
	"strings"
	"time"

	"brightbuy-backend/internal/reporting/app"
	"brightbuy-backend/internal/shared/httpx"

	"github.com/go-chi/chi/v5"
)

type Handler struct {
	service *app.Service
}

const (
	basisSales    = "order_date; cancelled orders excluded; sales value = total_amount - tax_amount - delivery_fee"
	basisCategory = "order_date; cancelled orders excluded; an order is counted once per category it contains"
	basisDelivery = "unfulfilled orders; estimated_date is today or later"
	basisCustomer = "customer order history; cancelled orders included; payment status is reported per order"
)

func NewHandler(service *app.Service) *Handler {
	return &Handler{service: service}
}

func RegisterRoutes(r chi.Router, handler *Handler) {
	r.Route("/api/v1/reports", func(r chi.Router) {
		r.Use(RequirePermission("reports:view"))

		r.Get("/quarterly-sales", handler.quarterlySales)
		r.Get("/top-selling-products", handler.topSellingProducts)
		r.Get("/category-wise-orders", handler.categoryWiseOrders)
		r.Get("/upcoming-deliveries", handler.upcomingDeliveries)
		r.Get("/customer-order-summary", handler.customerOrderPayments)
	})
}

func (h *Handler) quarterlySales(w http.ResponseWriter, r *http.Request) {
	year, err := queryInt(r, "year")
	if err != nil {
		httpx.WriteError(w, http.StatusBadRequest, "INVALID_YEAR", err.Error())
		return
	}
	rows, err := h.service.QuarterlySales(r.Context(), year)
	if err != nil {
		httpx.WriteError(w, http.StatusBadRequest, "INVALID_REPORT_REQUEST", err.Error())
		return
	}
	w.Header().Set("X-Report-Basis", basisSales)
	if wantsCSV(r) {
		writeCSV(w, "quarterly-sales.csv", []string{"year", "quarter", "sales_value"}, func(c *csv.Writer) error {
			for _, row := range rows {
				if err := c.Write([]string{strconv.Itoa(row.Year), strconv.Itoa(row.Quarter), row.SalesValue}); err != nil {
					return err
				}
			}
			return nil
		})
		return
	}
	writeJSON(w, rows)
}

func (h *Handler) topSellingProducts(w http.ResponseWriter, r *http.Request) {
	from, to, err := queryDateRange(r)
	if err != nil {
		httpx.WriteError(w, http.StatusBadRequest, "INVALID_DATE_RANGE", err.Error())
		return
	}
	limit := 20
	if raw := r.URL.Query().Get("limit"); raw != "" {
		limit, err = strconv.Atoi(raw)
		if err != nil {
			httpx.WriteError(w, http.StatusBadRequest, "INVALID_LIMIT", "limit must be an integer")
			return
		}
	}
	rows, err := h.service.TopSellingProducts(r.Context(), from, to, limit)
	if err != nil {
		httpx.WriteError(w, http.StatusBadRequest, "INVALID_REPORT_REQUEST", err.Error())
		return
	}
	w.Header().Set("X-Report-Basis", basisSales)
	if wantsCSV(r) {
		writeCSV(w, "top-selling-products.csv", []string{"product_id", "product_name", "quantity_sold", "revenue"}, func(c *csv.Writer) error {
			for _, row := range rows {
				if err := c.Write([]string{strconv.FormatInt(row.ProductID, 10), row.ProductName, strconv.FormatInt(row.Quantity, 10), row.Revenue}); err != nil {
					return err
				}
			}
			return nil
		})
		return
	}
	writeJSON(w, rows)
}

func (h *Handler) categoryWiseOrders(w http.ResponseWriter, r *http.Request) {
	from, to, err := optionalDateRange(r)
	if err != nil {
		httpx.WriteError(w, http.StatusBadRequest, "INVALID_DATE_RANGE", err.Error())
		return
	}
	rows, err := h.service.CategoryWiseOrders(r.Context(), from, to)
	if err != nil {
		httpx.WriteError(w, http.StatusBadRequest, "INVALID_REPORT_REQUEST", err.Error())
		return
	}
	w.Header().Set("X-Report-Basis", basisCategory)
	if wantsCSV(r) {
		writeCSV(w, "category-wise-orders.csv", []string{"category_id", "category_name", "order_count"}, func(c *csv.Writer) error {
			for _, row := range rows {
				if err := c.Write([]string{strconv.FormatInt(row.CategoryID, 10), row.CategoryName, strconv.FormatInt(row.OrderCount, 10)}); err != nil {
					return err
				}
			}
			return nil
		})
		return
	}
