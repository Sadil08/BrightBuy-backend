func TestHasPermission(t *testing.T) {

	permissions := []string{
		"orders:view",
		"reports:view",
		"products:view",
	}

	if !hasPermission(
		permissions,
		"reports:view",
	) {
		t.Fatal(
			"expected reports:view permission to be found",
		)
	}

	if hasPermission(
		permissions,
		"admin:delete",
	) {
		t.Fatal(
			"did not expect admin:delete permission",
		)
	}
}
