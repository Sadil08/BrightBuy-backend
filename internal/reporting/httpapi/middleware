package httpapi

import (
	"context"
	"net/http"
)

type contextKey string

const permissionsContextKey contextKey = "permissions"

// WithPermissions stores authenticated permissions in the request context.
//
// IMPORTANT:
// This function should ONLY be called by your trusted authentication/
// authorization middleware after the user's JWT/session has been verified.
//
// Do not populate permissions from a client-controlled header or query parameter.
func WithPermissions(ctx context.Context, permissions []string) context.Context {
	return context.WithValue(
		ctx,
		permissionsContextKey,
		permissions,
	)
}

// PermissionsFromContext returns the permissions stored by the
// authentication middleware.
func PermissionsFromContext(ctx context.Context) []string {
	permissions, ok := ctx.Value(permissionsContextKey).([]string)
	if !ok {
		return nil
	}

	return permissions
}

// RequirePermission protects an endpoint with a specific permission.
//
// Example:
//
//	r.Use(RequirePermission("reports:view"))
//
// A request is allowed only when the authenticated user's permissions
// contain the required permission.
func RequirePermission(permission string) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {

			permissions := PermissionsFromContext(r.Context())

			if !hasPermission(permissions, permission) {
				http.Error(
					w,
					"forbidden",
					http.StatusForbidden,
				)
				return
			}

			next.ServeHTTP(w, r)
		})
	}
}

func hasPermission(
	permissions []string,
	required string,
) bool {
	for _, permission := range permissions {
		if permission == required {
			return true
		}
	}

	return false
}
